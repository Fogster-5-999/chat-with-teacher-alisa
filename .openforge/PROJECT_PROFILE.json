{
  "project_profile": {
    "dynamic_discovery": true,
    "auto_detect": [
      "language",
      "framework",
      "architecture",
      "package_manager",
      "build_system",
      "test_framework",
      "linter",
      "formatter",
      "ci",
      "deployment",
      "state_management",
      "rendering_engine",
      "game_engine",
      "database"
